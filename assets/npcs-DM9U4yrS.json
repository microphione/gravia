{
  "format": 1,
  "npcs": [
    {
      "id": "ferryman",
      "name": "Ferryman",
      "line": "The crossing is short. Shall I take you over to the other island?",
      "choices": [
        { "id": "travel", "text": "Yes, take me across.", "effect": "travel" },
        { "id": "bye", "text": "Not now.", "effect": "end" }
      ]
    },
    {
      "id": "farmer",
      "name": "Farmer",
      "line": "Good day. Mind the mud, it clings to boots.",
      "choices": [
        { "id": "chat", "text": "What's new with you?", "effect": "say", "next": "news" },
        { "id": "work", "text": "Do you need help?", "effect": "say", "next": "work" },
        { "id": "bye", "text": "Goodbye.", "effect": "end" }
      ],
      "nodes": [
        {
          "id": "work",
          "line": "There is always work on a farm.",
          "choices": [
            { "id": "ask", "text": "What can I do?", "effect": "quest-start", "quest": "rat-tails", "next": "ask-yes", "requires": [{ "type": "level", "min": 1 }, { "type": "quest", "quest": "rat-tails", "state": "none" }] },
            { "id": "hand-in", "text": "I have your rat tails.", "effect": "quest-done", "quest": "rat-tails", "next": "hand-in-thanks", "requires": [{ "type": "quest", "quest": "rat-tails", "state": "active" }] },
            { "id": "more-work", "text": "Any more work for me?", "effect": "say", "next": "more", "requires": [{ "type": "quest", "quest": "rat-tails", "state": "done" }] },
            { "id": "work-back", "text": "Never mind.", "effect": "say" }
          ]
        },
        {
          "id": "more",
          "line": "Now that you mention it, aye.",
          "choices": [
            { "id": "ask-herbs", "text": "What do you need?", "effect": "quest-start", "quest": "herb-bundle", "next": "ask-herbs-yes", "requires": [{ "type": "level", "min": 2 }, { "type": "quest", "quest": "herb-bundle", "state": "none" }] },
            { "id": "hand-in-herbs", "text": "I have the healing herbs.", "effect": "quest-done", "quest": "herb-bundle", "next": "hand-in-herbs-thanks", "requires": [{ "type": "quest", "quest": "herb-bundle", "state": "active" }] },
            { "id": "further-work", "text": "And after that?", "effect": "say", "next": "further", "requires": [{ "type": "quest", "quest": "herb-bundle", "state": "done" }] },
            { "id": "more-back", "text": "Never mind.", "effect": "say" }
          ]
        },
        {
          "id": "further",
          "line": "You are a fine hand, I will say that.",
          "choices": [
            { "id": "ask-potions", "text": "What is it this time?", "effect": "quest-start", "quest": "farmer-potions", "next": "ask-potions-yes", "requires": [{ "type": "level", "min": 3 }, { "type": "quest", "quest": "farmer-potions", "state": "none" }] },
            { "id": "hand-in-potions", "text": "I have the health potions.", "effect": "quest-done", "quest": "farmer-potions", "next": "hand-in-potions-thanks", "requires": [{ "type": "quest", "quest": "farmer-potions", "state": "active" }] },
            { "id": "further-back", "text": "Never mind.", "effect": "say" }
          ]
        },
        {
          "id": "ask-herbs-yes",
          "line": "Aye. The little ones are down with fever. Bring me six healing herbs.",
          "choices": [
            { "id": "ask-herbs-back", "text": "I will fetch them.", "effect": "say" }
          ]
        },
        {
          "id": "hand-in-herbs-thanks",
          "line": "Good green herbs. The village will sleep easier tonight.",
          "choices": [
            { "id": "thanks-herbs-back", "text": "Glad to help.", "effect": "say" }
          ]
        },
        {
          "id": "ask-potions-yes",
          "line": "Winter is coming. Bring me two health potions, and the barn is yours to call friend.",
          "choices": [
            { "id": "ask-potions-back", "text": "I will see to it.", "effect": "say" }
          ]
        },
        {
          "id": "hand-in-potions-thanks",
          "line": "Fine brewing! You have my thanks again.",
          "choices": [
            { "id": "thanks-potions-back", "text": "Glad to help.", "effect": "say" }
          ]
        },
        {
          "id": "ask-yes",
          "line": "Aye, the rats are eating me out of house and home.",
          "choices": [
            { "id": "ask-yes-back", "text": "I will see to it.", "effect": "say" }
          ]
        },
        {
          "id": "hand-in-thanks",
          "line": "Fine tails! You have my thanks, and the village's.",
          "choices": [
            { "id": "thanks-back", "text": "Glad to help.", "effect": "say" }
          ]
        },
        {
          "id": "news",
          "line": "The barley is up, but the rats are fat this year.",
          "choices": [
            { "id": "rats", "text": "Fat rats?", "effect": "say", "next": "rats" },
            { "id": "weather", "text": "How is the weather?", "effect": "say", "next": "weather" },
            { "id": "news-back", "text": "Let me ask something else.", "effect": "say" }
          ]
        },
        {
          "id": "rats",
          "line": "They eat my grain and leave their tails behind.",
          "choices": [
            { "id": "rats-back", "text": "Ugly business.", "effect": "say" },
            { "id": "rats-news", "text": "Tell me more news.", "effect": "say", "next": "news" }
          ]
        },
        {
          "id": "weather",
          "line": "Dry for now. My knee says rain by the weekend.",
          "choices": [
            { "id": "weather-back", "text": "Take care of that knee.", "effect": "say" },
            { "id": "weather-news", "text": "Tell me more news.", "effect": "say", "next": "news" }
          ]
        }
      ]
    },
    {
      "id": "trader",
      "name": "Trader",
      "line": "Welcome, friend. Bread, cheese, and fair prices.",
      "choices": [
        { "id": "chat", "text": "What's new with you?", "effect": "say", "next": "news" },
        { "id": "trade", "text": "Let's trade.", "effect": "trade" },
        { "id": "bye", "text": "Goodbye.", "effect": "end" }
      ],
      "nodes": [
        {
          "id": "news",
          "line": "Slow days. The road is quiet and my cart is full.",
          "choices": [
            { "id": "road", "text": "Why is the road quiet?", "effect": "say", "next": "road" },
            { "id": "news-back", "text": "Let me ask something else.", "effect": "say" }
          ]
        },
        {
          "id": "road",
          "line": "Folk stay home when the wolves howl at night.",
          "choices": [
            { "id": "road-back", "text": "I will be careful.", "effect": "say" }
          ]
        }
      ],
      "shop": {
        "sells": [
          { "item": "bread", "price": 6 },
          { "item": "cheese", "price": 5 },
          { "item": "small-health-potion", "price": 15 },
          { "item": "small-mana-potion", "price": 15 }
        ],
        "buys": [
          { "item": "rat-tail", "price": 1 },
          { "item": "rat-corpse", "price": 5, "freshOnly": true }
        ],
        "purse": { "cap": 100, "refillGold": 1, "refillEveryMs": 10000 }
      }
    },
    {
      "id": "house-agent",
      "name": "House agent",
      "line": "Welcome home. What shall I see to in the house?",
      "choices": [
        { "id": "floor-up", "text": "Build a floor above ({price} gold).", "effect": "house-floor-up", "next": "built" },
        { "id": "floor-down", "text": "Dig a floor below ({price} gold).", "effect": "house-floor-down", "next": "built" },
        { "id": "give-up", "text": "I give this house up.", "effect": "house-give-up", "next": "gave-up" },
        { "id": "bye", "text": "Not now.", "effect": "end" }
      ],
      "nodes": [
        {
          "id": "built",
          "line": "It is done. Take a look.",
          "choices": [
            { "id": "built-back", "text": "Thank you.", "effect": "say" }
          ]
        },
        {
          "id": "gave-up",
          "line": "The house is no longer yours. Farewell.",
          "choices": [
            { "id": "gave-up-back", "text": "Farewell.", "effect": "say" }
          ]
        }
      ],
      "houseAgent": { "floorUpPrice": 5, "floorDownPrice": 5 }
    },
    {
      "id": "boatman",
      "name": "Boatman",
      "line": "The boat leaves in {departure}.",
      "choices": [
        { "id": "board", "text": "I want to sail.", "effect": "board", "next": "board-ok" },
        { "id": "when", "text": "When does it leave?", "effect": "say", "next": "when" },
        { "id": "bye", "text": "Not now.", "effect": "end" }
      ],
      "nodes": [
        {
          "id": "board-ok",
          "line": "Take a seat when you are by the boat. It leaves in {departure}.",
          "choices": [
            { "id": "board-ok-back", "text": "Thank you.", "effect": "say" }
          ]
        },
        {
          "id": "when",
          "line": "Next departure in {departure}. Do not be late.",
          "choices": [
            { "id": "when-back", "text": "I see.", "effect": "say" }
          ]
        }
      ]
    },
    {
      "id": "depot-keeper",
      "name": "Depot keeper",
      "line": "Your things are safe with me. Shall I open your depot?",
      "choices": [
        { "id": "open", "text": "Show me my depot.", "effect": "depot-open" },
        { "id": "bye", "text": "Not now.", "effect": "end" }
      ],
      "depot": true
    }
  ]
}
